{
  "_comment": "MODÈLE. Pour activer : relisez ce fichier, puis renommez-le en .mcp.json (cp .mcp.json.example .mcp.json). Claude Code chargera alors les deux serveurs MCP au démarrage. Remplacez GOOGLE_PROJECT_ID par l'ID de votre projet Google Cloud.",
  "mcpServers": {
    "gsc": {
      "command": "npx",
      "args": ["-y", "mcp-server-gsc"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${PWD}/credentials/service-account.json"
      }
    },
    "ga4": {
      "command": "pipx",
      "args": ["run", "analytics-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${PWD}/credentials/service-account.json",
        "GOOGLE_PROJECT_ID": "REMPLACER_PAR_VOTRE_PROJECT_ID"
      }
    }
  }
}
